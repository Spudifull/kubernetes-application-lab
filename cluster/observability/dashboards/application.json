{
  "uid": "lab-application-metrics",
  "title": "Lab Application Metrics",
  "description": "Application HTTP, publisher, worker and outbox metrics. Dependency metrics are on Lab Dependency Metrics; links open Loki and Tempo. Outbox gauges require fresh successful SQL samples; process counters reset on restart.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": ["lab","application"],
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from":"now-30m","to":"now"},
  "panels": [
    {"id":1,"title":"API scrape availability (not HTTP probe)","type":"stat","gridPos":{"x":0,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"min(up{namespace=\"kubernetes-application-lab\",service=\"lab-api\"})","instant":true}],"fieldConfig":{"defaults":{"min":0,"max":1}}},
    {"id":2,"title":"Available worker replicas (fixed/KEDA)","type":"stat","gridPos":{"x":6,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kube_deployment_status_replicas_available{namespace=\"kubernetes-application-lab\",deployment=\"lab-worker\"}","instant":true}]},
    {"id":3,"title":"Outbox pending (fresh successful SQL only)","type":"stat","gridPos":{"x":12,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"max(lab_outbox_pending_events{namespace=\"kubernetes-application-lab\"} and on(instance) (lab_outbox_stats_up{namespace=\"kubernetes-application-lab\"} == 1) and on(instance) ((time()-lab_outbox_stats_last_success_timestamp_seconds{namespace=\"kubernetes-application-lab\"}) < 30))","instant":true}]},
    {"id":4,"title":"Outbox sample age seconds (must be <30)","type":"stat","gridPos":{"x":18,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"max(time()-lab_outbox_stats_last_success_timestamp_seconds{namespace=\"kubernetes-application-lab\"})","instant":true}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":5,"title":"HTTP application requests/s (excluding probes/metrics)","type":"timeseries","gridPos":{"x":0,"y":5,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by(route,status)(rate(lab_http_requests_total{namespace=\"kubernetes-application-lab\",route!~\"GET /(metrics|livez|readyz|version)\"}[2m]))","legendFormat":"__auto"}],"fieldConfig":{"defaults":{"unit":"reqps"}}},
    {"id":6,"title":"HTTP application p95 seconds (histogram estimate)","type":"timeseries","gridPos":{"x":12,"y":5,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by(le)(rate(lab_http_request_latency_seconds_bucket{namespace=\"kubernetes-application-lab\",route!~\"GET /(metrics|livez|readyz|version)\"}[5m])))"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":7,"title":"Flow rates: enqueue / outbox mark / SQL effect (not lag)","type":"timeseries","gridPos":{"x":0,"y":13,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(lab_http_requests_total{namespace=\"kubernetes-application-lab\",route=\"POST /jobs\",status=\"202\"}[2m]))","legendFormat":"HTTP accepted (includes idempotent replay)"},{"refId":"B","expr":"sum(rate(lab_publisher_outbox_published_total{namespace=\"kubernetes-application-lab\"}[2m]))","legendFormat":"durable outbox marks"},{"refId":"C","expr":"sum(rate(lab_worker_jobs_processed_total{namespace=\"kubernetes-application-lab\"}[2m]))","legendFormat":"new SQL effects"}]},
    {"id":8,"title":"Publisher Kafka errors and worker attempt failures /s","type":"timeseries","gridPos":{"x":12,"y":13,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(lab_publisher_publish_errors_total{namespace=\"kubernetes-application-lab\"}[2m]))","legendFormat":"publisher delivery failures"},{"refId":"B","expr":"sum(rate(lab_worker_jobs_failed_total{namespace=\"kubernetes-application-lab\"}[2m]))","legendFormat":"worker failed attempts"}]},
    {"id":9,"title":"Worker retries / duplicates / durable DLQ receipts (process counters)","type":"timeseries","gridPos":{"x":0,"y":21,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(lab_worker_jobs_retried_total{namespace=\"kubernetes-application-lab\"})","legendFormat":"persisted retries"},{"refId":"B","expr":"sum(lab_worker_jobs_duplicates_total{namespace=\"kubernetes-application-lab\"})","legendFormat":"duplicate observations"},{"refId":"C","expr":"sum(lab_worker_jobs_dlq_total{namespace=\"kubernetes-application-lab\"})","legendFormat":"durable DLQ receipts"}]},
    {"id":10,"title":"Worker attempt p95 and active attempts","type":"timeseries","gridPos":{"x":12,"y":21,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by(le)(rate(lab_worker_attempt_duration_seconds_bucket{namespace=\"kubernetes-application-lab\"}[5m])))","legendFormat":"attempt p95 seconds"},{"refId":"B","expr":"sum(lab_worker_active{namespace=\"kubernetes-application-lab\"})","legendFormat":"active attempts"}]},
    {"id":11,"title":"Oldest pending event age (fresh successful SQL only)","type":"timeseries","gridPos":{"x":0,"y":29,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"max(lab_outbox_oldest_pending_age_seconds{namespace=\"kubernetes-application-lab\"} and on(instance) (lab_outbox_stats_up{namespace=\"kubernetes-application-lab\"} == 1) and on(instance) ((time()-lab_outbox_stats_last_success_timestamp_seconds{namespace=\"kubernetes-application-lab\"}) < 30))"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":12,"title":"Kafka offset commit failures/s (not SQL failures)","type":"timeseries","gridPos":{"x":12,"y":29,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(lab_worker_kafka_offset_commit_failures_total{namespace=\"kubernetes-application-lab\"}[2m]))"}]},
    {"id":13,"title":"HTTP application errors/s (4xx and 5xx)","type":"timeseries","gridPos":{"x":0,"y":37,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by(status)(rate(lab_http_requests_total{namespace=\"kubernetes-application-lab\",route!~\"GET /(metrics|livez|readyz|version)\",status=~\"[45]..\"}[2m]))","legendFormat":"__auto"}],"fieldConfig":{"defaults":{"unit":"reqps"}}},
    {"id":14,"title":"HTTP application mean latency (no traffic is undefined)","type":"timeseries","gridPos":{"x":12,"y":37,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(lab_http_request_duration_seconds_sum{namespace=\"kubernetes-application-lab\",route!~\"GET /(metrics|livez|readyz|version)\"}[5m])) / sum(rate(lab_http_request_duration_seconds_count{namespace=\"kubernetes-application-lab\",route!~\"GET /(metrics|livez|readyz|version)\"}[5m]))","legendFormat":"__auto"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":15,"title":"HTTP active requests (includes probes/metrics)","type":"stat","gridPos":{"x":0,"y":45,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(lab_http_requests_active{namespace=\"kubernetes-application-lab\"})","legendFormat":"__auto","instant":true}]},
    {"id":16,"title":"Available API replicas (Kubernetes readiness)","type":"stat","gridPos":{"x":6,"y":45,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kube_deployment_status_replicas_available{namespace=\"kubernetes-application-lab\",deployment=\"lab-api\"}","legendFormat":"__auto","instant":true}]},
    {"id":17,"title":"API build revision (value is an info marker)","type":"stat","gridPos":{"x":12,"y":45,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"lab_build_info{namespace=\"kubernetes-application-lab\",service=\"lab-api\"}","legendFormat":"{{revision}}","instant":true}],"options":{"textMode":"value_and_name","colorMode":"value"}},
    {"id":18,"title":"Available publisher replicas (not broker acknowledgement)","type":"stat","gridPos":{"x":18,"y":45,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"kube_deployment_status_replicas_available{namespace=\"kubernetes-application-lab\",deployment=\"lab-publisher\"}","legendFormat":"__auto","instant":true}]},
    {"id":19,"title":"Publisher broker acknowledgements / outbox marks (process counters)","type":"timeseries","gridPos":{"x":0,"y":50,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(lab_publisher_publish_success_total{namespace=\"kubernetes-application-lab\"})","legendFormat":"broker acknowledgements"},{"refId":"B","expr":"sum(lab_publisher_outbox_published_total{namespace=\"kubernetes-application-lab\"})","legendFormat":"durable outbox marks"}]},
    {"id":20,"title":"Publisher delivery errors (process counter)","type":"timeseries","gridPos":{"x":12,"y":50,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(lab_publisher_publish_errors_total{namespace=\"kubernetes-application-lab\"})","legendFormat":"delivery errors"}]}
  ],
  "links": [{"title":"Dependency metrics","type":"link","url":"/d/lab-dependency-metrics/lab-dependency-metrics","keepTime":true},{"title":"Logs in Loki","type":"link","url":"/explore?schemaVersion=1&panes=%7B%22logs%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bnamespace%3D%5C%22kubernetes-application-lab%5C%22%2Cservice%3D%7E%5C%22lab-api%7Clab-publisher%7Clab-worker%5C%22%7D+%7C+json%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22queryType%22%3A%22range%22%2C%22editorMode%22%3A%22code%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-30m%22%2C%22to%22%3A%22now%22%7D%7D%7D"},{"title":"Traces in Tempo","type":"link","url":"/explore?schemaVersion=1&panes=%7B%22traces%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceqlSearch%22%2C%22query%22%3A%22%7B%7D%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-30m%22%2C%22to%22%3A%22now%22%7D%7D%7D"}]
}
