{
  "uid": "lab-dependency-metrics",
  "title": "Lab Dependency Metrics",
  "description": "Prepared dependency telemetry. Missing samples are unknown, never healthy zeros. Kafka lag is compared independently with worker-group-status. Group membership is not group state. PostgreSQL statistics cover the server, not just application pools.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": ["lab","dependencies"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from":"now-30m","to":"now"},
  "panels": [
    {"id":1,"title":"Exporter scrape health (not dependency health)","type":"stat","gridPos":{"x":0,"y":0,"w":8,"h":5},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"up{namespace=\"kubernetes-application-lab-observability\",job=~\"lab-(postgres|kafka)-exporter\"}","instant":true}]},
    {"id":2,"title":"PostgreSQL connection succeeds","type":"stat","gridPos":{"x":8,"y":0,"w":8,"h":5},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"pg_up{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\"}","instant":true}]},
    {"id":3,"title":"Kafka discovered brokers (expect 1)","type":"stat","gridPos":{"x":16,"y":0,"w":8,"h":5},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"kafka_brokers{namespace=\"kubernetes-application-lab-observability\",job=\"lab-kafka-exporter\"}","instant":true}]},
    {"id":4,"title":"Consumer lag by partition (not log size; negative is unknown)","type":"timeseries","gridPos":{"x":0,"y":5,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"kafka_consumergroup_lag{namespace=\"kubernetes-application-lab-observability\",job=\"lab-kafka-exporter\",consumergroup=\"lab-workers\",topic=\"lab.jobs.v1\"}"}]},
    {"id":5,"title":"Group members and available worker replicas (not group state)","type":"timeseries","gridPos":{"x":12,"y":5,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"kafka_consumergroup_members{namespace=\"kubernetes-application-lab-observability\",job=\"lab-kafka-exporter\",consumergroup=\"lab-workers\"}","legendFormat":"group members"},{"refId":"B","expr":"kube_deployment_status_replicas_available{namespace=\"kubernetes-application-lab\",deployment=\"lab-worker\"}","legendFormat":"available replicas"}]},
    {"id":6,"title":"PostgreSQL client connections / configured maximum (not usable slots)","type":"timeseries","gridPos":{"x":0,"y":13,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"sum(pg_stat_database_numbackends{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\"}) / max(pg_settings_max_connections{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\"})"}],"fieldConfig":{"defaults":{"unit":"percentunit"}}},
    {"id":7,"title":"PostgreSQL transaction commits and rollbacks /s","type":"timeseries","gridPos":{"x":12,"y":13,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"rate(pg_stat_database_xact_commit{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\",datname=\"lab\"}[2m])","legendFormat":"commit/s"},{"refId":"B","expr":"rate(pg_stat_database_xact_rollback{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\",datname=\"lab\"}[2m])","legendFormat":"rollback/s"}]},
    {"id":8,"title":"Kafka broker requests/s (JMX; bounded request/version labels)","type":"timeseries","gridPos":{"x":0,"y":21,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"sum by(request)(rate(lab_kafka_broker_requests_total{namespace=\"kubernetes-application-lab-kafka\",job=\"lab-kafka-jmx\"}[2m]))"}]},
    {"id":9,"title":"Kafka broker errors/s (NONE excluded; absent is not zero)","type":"timeseries","gridPos":{"x":12,"y":21,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"sum by(request,error)(rate(lab_kafka_broker_errors_total{namespace=\"kubernetes-application-lab-kafka\",job=\"lab-kafka-jmx\",error!=\"NONE\"}[2m]))"}]},
    {"id":10,"title":"PostgreSQL sessions by state","type":"timeseries","gridPos":{"x":0,"y":29,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"sum by(state)(pg_stat_activity_count{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\",datname=\"lab\"})"}]},
    {"id":11,"title":"PostgreSQL collector error (0 healthy; missing unknown)","type":"stat","gridPos":{"x":12,"y":29,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"refId":"A","expr":"pg_exporter_last_scrape_error{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\"}","instant":true}]},
    {"id":12,"title":"PostgreSQL client connections and configured maximum","type":"timeseries","gridPos":{"x":0,"y":37,"w":24,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(pg_stat_database_numbackends{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\"})","legendFormat":"client connections"},{"refId":"B","expr":"max(pg_settings_max_connections{namespace=\"kubernetes-application-lab-observability\",job=\"lab-postgres-exporter\"})","legendFormat":"configured maximum (includes reserved slots)"}]}
  ]
}
